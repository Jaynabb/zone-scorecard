//@version=6
indicator("Jay S&D", overlay=true, max_bars_back=500, max_boxes_count=500, max_labels_count=500, max_lines_count=100)

//-----------------------------------------------------------------------------
// SETTINGS
//-----------------------------------------------------------------------------
string poi_group = 'Zone Settings'
int max_zones = input.int(12, 'Max Zones Kept Per Timeframe', minval=2, group=poi_group, tooltip='Zones kept in memory per timeframe and side. Only the nearest ones are drawn, see Zone Filters.')
int typ_len = input.int(20, 'Typical Body Lookback', minval=5, group=poi_group, tooltip='Number of candles used to measure the typical candle body (the median, so a few crash candles do not distort it). Every size rule below is a multiple of this typical body, so the script scales itself to any market and timeframe.')
float impulse_mult = input.float(1.0, 'Impulse Min Body (x typical body)', minval=0.25, step=0.25, group=poi_group, tooltip='Floor for an impulse candle: its body must be at least this many typical bodies and move away from the base. The real test is relative: every base candle must be small compared with the impulse, see Base Candle Max.')
float base_mult = input.float(0.5, 'Base Candle Max (x impulse body)', minval=0.1, maxval=1.0, step=0.1, group=poi_group, tooltip='A candle counts as part of the base only if its body is at most this fraction of the impulse body. 0.5 means the impulse is at least twice every base candle.')
int base_max = input.int(4, 'Max Base Candles', minval=1, maxval=20, group=poi_group, tooltip='The base is the run of small candles immediately left of the impulse. Each one must share price with the candle right next to the impulse, so the walk stops where the pause started. Supply zone = base wick high to lowest base body. Demand zone = base wick low to highest base body.')
float box_width = input.float(1.0, 'Fallback Zone Width (x typical body)', step=0.25, group=poi_group, tooltip='Only used when the base has no height, for example a single doji with no wick.')
int zz_len = input.int(10, 'Zig Zag Swing Length', minval=1, group=poi_group, tooltip='Only used by the Zig Zag and swing labels on the chart timeframe.')

string filt_group = 'Zone Filters'
bool use_departure = input.bool(true, 'Require Strong Departure', group=filt_group, tooltip='Keep a zone only if price left it by at least the departure multiple of the zone height within the given number of candles. This is the 2x move rule.')
float dep_mult = input.float(1.0, 'Departure (x zone height)', minval=0.25, step=0.25, group=filt_group, tooltip='Price must travel at least this many zone heights beyond the zone edge for the zone to count. Your 2x scoring rule still applies on the scorecard; this only decides whether a zone is drawn.')
int dep_bars = input.int(8, 'Departure Within (candles)', minval=1, maxval=20, group=filt_group, tooltip='A zone appears as soon as the impulse candle alone has departed this far, otherwise once the follow-through has, checked this many candles after the impulse.')
float max_height_mult = input.float(4.0, 'Max Zone Height (x typical body)', minval=0.5, step=0.5, group=filt_group, tooltip='Zones taller than this many typical bodies of their own timeframe are skipped.')
int max_touches = input.int(2, 'Remove Zone After N Touches', minval=0, group=filt_group, tooltip='A touch is price entering the zone without closing through it. 0 = never remove by touches.')
bool corr_only = input.bool(false, 'Hide Higher Timeframe Zones Without Correlation', group=filt_group, tooltip='Off: higher timeframe zones are drawn as hollow frames wherever they are, which shows where price is heading. On: they are drawn only where they overlap a chart timeframe zone of the same side. Zones from lower timeframes are never drawn either way.')
int show_n = input.int(3, 'Show Nearest Zones Per Side', minval=1, maxval=20, group=filt_group, tooltip='Per timeframe: draw only this many supply zones above price and demand zones below price. The rest stay in memory and appear when price moves toward them.')

string tf_group = 'Timeframes'
bool show_d = input.bool(true, 'Daily zones', group=tf_group)
bool show_w = input.bool(true, 'Weekly zones', group=tf_group)
bool show_m = input.bool(true, 'Monthly zones', group=tf_group)
bool highlight_nearest = input.bool(true, 'Outline Nearest Zones In White', group=tf_group, tooltip='On the chart timeframe, the closest supply above price and the closest demand below price get a white border and a TARGET label. Higher timeframe frames are never tagged as targets.')

string visual_group = 'Visual Settings'
color supply_color = input.color(#F23645, 'Supply Color', group=visual_group)
color demand_color = input.color(#089981, 'Demand Color', group=visual_group)
color highlight_color = input.color(color.white, 'Nearest Zone Outline', group=visual_group)
color label_color = input.color(color.white, 'Text Color', group=visual_group)
int transp_m = input.int(70, 'Monthly Fill Transparency', minval=0, maxval=100, group=visual_group)
int transp_w = input.int(78, 'Weekly Fill Transparency', minval=0, maxval=100, group=visual_group)
int transp_d = input.int(86, 'Daily Fill Transparency', minval=0, maxval=100, group=visual_group)
bool show_zigzag = input.bool(true, 'Show Zig Zag (chart timeframe)', group=visual_group)
bool show_labels = input.bool(false, 'Show Swing Labels (chart timeframe)', group=visual_group)
color zigzag_color = input.color(color.gray, 'ZigZag Color', group=visual_group)
bool hollow_htf = input.bool(true, 'Higher Timeframes As Hollow Frames', group=visual_group, tooltip='Zones from timeframes above the chart are drawn as outlines with no fill, yellow for Weekly and orange for Monthly, so a chart timeframe zone sitting inside one reads as a solid box in a colored frame.')
bool backing_fill = input.bool(true, 'Stronger Fill With Higher Timeframe Backing', group=visual_group, tooltip='A chart timeframe zone that overlaps one higher timeframe zone is filled darker, two higher timeframes darker still.')
bool label_targets_only = input.bool(true, 'Label Only The Target Zones', group=visual_group, tooltip='Only the white outlined zones (the nearest on each side) get a label: timeframe, side, price range and the word TARGET, placed in the margin right of the last candle. Other boxes stay unlabeled. Turn off to also print timeframe and side inside every box.')
color weekly_color = input.color(#FFD400, 'Weekly Frame Color', group=visual_group, tooltip='Weekly zones on a lower timeframe chart are drawn as hollow outlines in this color, with a matching tag in the right margin.')
color monthly_color = input.color(#FF8C00, 'Monthly Frame Color', group=visual_group, tooltip='Monthly zones on a lower timeframe chart are drawn as hollow outlines in this color, with a matching tag in the right margin.')

//-----------------------------------------------------------------------------
// TYPES, ARRAYS & GLOBALS
//-----------------------------------------------------------------------------
type Zone
    box b
    int touches = 0
    bool inside = false

// slot 0 = Daily, 1 = Weekly, 2 = Monthly
var array<Zone> sup_d = array.new<Zone>()
var array<Zone> dem_d = array.new<Zone>()
var array<Zone> sup_w = array.new<Zone>()
var array<Zone> dem_w = array.new<Zone>()
var array<Zone> sup_m = array.new<Zone>()
var array<Zone> dem_m = array.new<Zone>()
var array<box> broken_zones = array.new<box>()
var array<label> tgt_labels = array.new<label>()   // right-margin labels for the target zones, rebuilt on every refresh
// keys of bases already turned into zones (left_time * 8 + slot * 2 + side), so a repeated report is not drawn twice
var array<int> seen_keys = array.new<int>()

int chart_sec = timeframe.in_seconds()

// mode per slot: 0 = same as chart, 1 = higher than chart, 2 = lower than chart
f_mode(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec == chart_sec ? 0 : sec > chart_sec ? 1 : 2

int mode_d = f_mode("D")
int mode_w = f_mode("W")
int mode_m = f_mode("M")

//-----------------------------------------------------------------------------
// BASE DETECTION (runs inside each timeframe's own context)
//-----------------------------------------------------------------------------
// Looks at the candle k bars back. If it is an impulse (big body, moving away from the base),
// walks left over the small overlapping candles that form the base and returns the zone.
// Supply = base wick high down to the lowest base body. Demand = base wick low up to the highest base body.
// Returns [found, top, btm, left_time].
detect(bool is_supply, int k, float yard) =>
    float lim = yard * impulse_mult
    bool found = false
    float z_top = na
    float z_btm = na
    int lt = na
    float body = math.abs(close[k] - open[k])
    bool away = is_supply ? close[k] < open[k] : close[k] > open[k]
    if not na(body) and body >= lim and away
        float base_lim = body * base_mult
        float a_lo = na   // full range of the first base candle, the one next to the impulse
        float a_hi = na
        float w_lo = na   // running wick extremes of the base
        float w_hi = na
        int cnt = 0
        for j = 1 to base_max
            int off = k + j
            float bd = math.abs(close[off] - open[off])
            float bh = math.max(open[off], close[off])
            float bl = math.min(open[off], close[off])
            if na(bd) or bd > base_lim
                break
            if cnt > 0 and (bh < a_lo or bl > a_hi)
                break
            if cnt == 0
                a_lo := low[off]
                a_hi := high[off]
            cnt += 1
            w_lo := na(w_lo) ? low[off] : math.min(w_lo, low[off])
            w_hi := na(w_hi) ? high[off] : math.max(w_hi, high[off])
            z_top := is_supply ? w_hi : (na(z_top) ? bh : math.max(z_top, bh))
            z_btm := is_supply ? (na(z_btm) ? bl : math.min(z_btm, bl)) : w_lo
            lt := time[off]
        // V-shaped turn: no small base, but the candle next to the impulse holds the extreme.
        // That candle is the base on its own, wick to body.
        if cnt == 0
            int off = k + 1
            bool holds_extreme = is_supply ? high[off] >= high[k] : low[off] <= low[k]
            if not na(close[off]) and holds_extreme
                z_top := is_supply ? high[off] : math.max(open[off], close[off])
                z_btm := is_supply ? math.min(open[off], close[off]) : low[off]
                lt := time[off]
                cnt := 1
        if cnt > 0
            found := true
    [found, z_top, z_btm, lt]

// True when price travelled at least dep_mult x zone height beyond the zone edge over the k closed candles starting at the impulse.
departs(bool is_supply, int k, float top, float btm, float yard) =>
    bool ok = false
    float need = (top - btm) * dep_mult
    if not na(top) and not na(btm) and k >= 1
        float ext = na
        for i = 1 to k
            int off = k - i + 1
            ext := is_supply ? (na(ext) ? low[off] : math.min(ext, low[off])) : (na(ext) ? high[off] : math.max(ext, high[off]))
        ok := is_supply ? ext <= btm - need : ext >= top + need
    ok

// One candidate per side per bar: an impulse that closed last bar and already departed far enough,
// otherwise an impulse dep_bars ago whose follow-through has now departed far enough.
candidate(bool is_supply, float yard) =>
    [f1, t1, b1, l1] = detect(is_supply, 1, yard)
    bool dep1 = departs(is_supply, 1, t1, b1, yard)
    bool ok1 = f1 and (not use_departure or dep1)
    [f2, t2, b2, l2] = detect(is_supply, dep_bars, yard)
    bool dep2 = departs(is_supply, dep_bars, t2, b2, yard)
    bool ok2 = f2 and (not use_departure or dep2)
    bool found = ok1 or ok2
    float top = ok1 ? t1 : t2
    float btm = ok1 ? b1 : b2
    int lt = ok1 ? l1 : l2
    [found, top, btm, lt]

// Everything a timeframe reports each bar.
tf_pack() =>
    float yard = ta.median(math.abs(close - open), typ_len)
    [s_f, s_top, s_btm, s_t] = candidate(true, yard)
    [d_f, d_top, d_btm, d_t] = candidate(false, yard)
    [s_f, s_top, s_btm, s_t, d_f, d_top, d_btm, d_t, close, high, low, yard]

//-----------------------------------------------------------------------------
// DATA REQUESTS
// Higher or equal timeframes use request.security. Lower timeframes (for example
// Daily zones on a Weekly chart) use request.security_lower_tf. A slot that does
// not apply just requests the chart timeframe and is ignored later.
//-----------------------------------------------------------------------------
string tf_d_hi = mode_d == 1 ? "D" : timeframe.period
string tf_w_hi = mode_w == 1 ? "W" : timeframe.period
string tf_m_hi = mode_m == 1 ? "M" : timeframe.period
string tf_d_lo = mode_d == 2 ? "D" : timeframe.period
string tf_w_lo = mode_w == 2 ? "W" : timeframe.period

[d_sf, d_st, d_sb, d_stm, d_df, d_dt, d_db, d_dtm, d_c, d_h, d_l, d_a] = request.security(syminfo.tickerid, tf_d_hi, tf_pack())
[w_sf, w_st, w_sb, w_stm, w_df, w_dt, w_db, w_dtm, w_c, w_h, w_l, w_a] = request.security(syminfo.tickerid, tf_w_hi, tf_pack())
[m_sf, m_st, m_sb, m_stm, m_df, m_dt, m_db, m_dtm, m_c, m_h, m_l, m_a] = request.security(syminfo.tickerid, tf_m_hi, tf_pack())

[d_sf_a, d_st_a, d_sb_a, d_stm_a, d_df_a, d_dt_a, d_db_a, d_dtm_a, d_c_a, d_h_a, d_l_a, d_a_a] = request.security_lower_tf(syminfo.tickerid, tf_d_lo, tf_pack())
[w_sf_a, w_st_a, w_sb_a, w_stm_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_c_a, w_h_a, w_l_a, w_a_a] = request.security_lower_tf(syminfo.tickerid, tf_w_lo, tf_pack())

//-----------------------------------------------------------------------------
// ZONE FUNCTIONS
//-----------------------------------------------------------------------------
zone_style(int slot) =>
    int w = slot == 2 ? 2 : 1
    int tr = slot == 2 ? transp_m : slot == 1 ? transp_w : transp_d
    string nm = slot == 2 ? "MONTHLY" : slot == 1 ? "WEEKLY" : "DAILY"
    [w, tr, nm]

// true when any zone in the list overlaps the price range
method any_overlap(array<Zone> zones, float top, float btm) =>
    bool hit = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box ob = zones.get(i).b
            if top >= ob.get_bottom() and btm <= ob.get_top()
                hit := true
                break
    hit

// Higher timeframe backing for a zone of the given slot: returns [count, tag] such as [2, " +W +M"].
backing(int slot, bool is_supply, box b) =>
    float top = b.get_top()
    float btm = b.get_bottom()
    int cnt = 0
    string tag = ""
    if slot < 1 and show_w
        if (is_supply ? sup_w : dem_w).any_overlap(top, btm)
            cnt += 1
            tag := tag + " +W"
    if slot < 2 and show_m
        if (is_supply ? sup_m : dem_m).any_overlap(top, btm)
            cnt += 1
            tag := tag + " +M"
    [cnt, tag]

zone_text(int slot, bool is_supply, box b, string tag) =>
    [w, tr, nm] = zone_style(slot)
    nm + (is_supply ? " SUPPLY" : " DEMAND") + " " + str.tostring(b.get_bottom(), format.mintick) + " - " + str.tostring(b.get_top(), format.mintick) + "  TARGET" + tag

// Puts the target label in the empty space to the right of the last candle, where no candle can cover it.
mark_target(int slot, bool is_supply, box b, string tag) =>
    float mid = (b.get_top() + b.get_bottom()) / 2
    label l = label.new(bar_index + 2, mid, zone_text(slot, is_supply, b, tag), xloc=xloc.bar_index, style=label.style_label_left, color=highlight_color, textcolor=color.black, size=size.small)
    tgt_labels.push(l)

// Tag at the top edge of a hollow higher timeframe frame, in the frame's own color, so stacked frames can be told apart.
mark_frame(int slot, bool is_supply, box b) =>
    color fc = slot == 2 ? monthly_color : weekly_color
    string t = (slot == 2 ? "MONTHLY" : "WEEKLY") + (is_supply ? " SUPPLY" : " DEMAND")
    // Weekly tag on the top edge, Monthly tag on the bottom edge, so frames sharing an edge do not overlap
    float y = slot == 2 ? b.get_bottom() : b.get_top()
    label l = label.new(bar_index + 2, y, t, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=fc, size=size.small)
    tgt_labels.push(l)

method trim(array<Zone> zones, int limit) =>
    while zones.size() > limit
        Zone z = zones.pop()
        z.b.delete()

// true when the new price range touches an existing zone of the same timeframe and side
method overlaps(array<Zone> zones, float top, float btm) =>
    bool hit = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            if top >= b.get_bottom() and btm <= b.get_top()
                hit := true
                break
    hit

// z_top, z_btm = zone edges from the base
// yard_tf = typical (median) candle body of the zone's own timeframe
create_zone(array<Zone> zones, bool is_supply, float z_top, float z_btm, int left_time, int slot, float yard_tf) =>
    float buffer = yard_tf * box_width
    bool flat = na(z_top) or na(z_btm) or (z_top - z_btm) <= syminfo.mintick
    float anchor = is_supply ? z_top : z_btm
    float top = flat ? (is_supply ? anchor : anchor + buffer) : z_top
    float btm = flat ? (is_supply ? anchor - buffer : anchor) : z_btm
    bool ok = not na(top) and not na(btm)
    if (top - btm) > max_height_mult * yard_tf
        ok := false
    if ok and not zones.overlaps(top, btm)
        [w, tr, nm] = zone_style(slot)
        color base = is_supply ? supply_color : demand_color
        box b = box.new(left_time, top, time, btm, xloc=xloc.bar_time, border_color=base, border_width=w, bgcolor=color.new(base, tr), text=nm + (is_supply ? " SUPPLY" : " DEMAND"), text_color=label_color, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center, extend=extend.right)
        zones.unshift(Zone.new(b))
        zones.trim(max_zones)

// Break: a candle of the zone's own timeframe closes through the wick edge.
// Touch: price enters the zone without closing through it. After max_touches the zone is spent.
monitor(array<Zone> zones, bool is_supply, float c, float h, float l) =>
    if zones.size() > 0 and not na(c)
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            box b = z.b
            float limit_level = is_supply ? b.get_top() : b.get_bottom()
            bool broken = is_supply ? c >= limit_level : c <= limit_level
            if broken
                box bos = b.copy()
                float mid = (b.get_top() + b.get_bottom()) / 2
                bos.set_top(mid)
                bos.set_bottom(mid)
                bos.set_bgcolor(color.new(color.white, 100))
                bos.set_border_color(color.new(color.white, 80))
                bos.set_border_width(1)
                bos.set_text("")
                bos.set_extend(extend.none)
                bos.set_right(time)
                broken_zones.unshift(bos)
                if broken_zones.size() > 10
                    broken_zones.pop().delete()
                b.delete()
                zones.remove(i)
                continue
            bool touching = is_supply ? h >= b.get_bottom() : l <= b.get_top()
            if touching and not z.inside
                z.touches += 1
            z.inside := touching
            if max_touches > 0 and z.touches > max_touches
                b.delete()
                zones.remove(i)

// Adds a reported base as a zone once, keyed by its leftmost candle time.
add_once(array<Zone> zones, bool is_supply, int slot, bool found, float top, float btm, int lt, float atr_tf) =>
    if found and not na(lt)
        int key = lt * 8 + slot * 2 + (is_supply ? 0 : 1)
        if seen_keys.indexof(key) < 0
            seen_keys.unshift(key)
            if seen_keys.size() > 400
                seen_keys.pop()
            create_zone(zones, is_supply, top, btm, lt, slot, atr_tf)

process_slot(int slot, int mode, bool show, array<Zone> sup, array<Zone> dem, bool h_sf, float h_st, float h_sb, int h_stm, bool h_df, float h_dt, float h_db, int h_dtm, float h_c, float h_h, float h_l, float h_a, array<bool> l_sf, array<float> l_st, array<float> l_sb, array<int> l_stm, array<bool> l_df, array<float> l_dt, array<float> l_db, array<int> l_dtm, array<float> l_c, array<float> l_h, array<float> l_l, array<float> l_a) =>
    if show
        if mode == 2
            if l_c.size() > 0
                for i = 0 to l_c.size() - 1
                    add_once(sup, true, slot, l_sf.get(i), l_st.get(i), l_sb.get(i), l_stm.get(i), l_a.get(i))
                    add_once(dem, false, slot, l_df.get(i), l_dt.get(i), l_db.get(i), l_dtm.get(i), l_a.get(i))
                    monitor(sup, true, l_c.get(i), l_h.get(i), l_l.get(i))
                    monitor(dem, false, l_c.get(i), l_h.get(i), l_l.get(i))
        else
            add_once(sup, true, slot, h_sf, h_st, h_sb, h_stm, h_a)
            add_once(dem, false, slot, h_df, h_dt, h_db, h_dtm, h_a)
            monitor(sup, true, h_c, h_h, h_l)
            monitor(dem, false, h_c, h_h, h_l)

method extend_all(array<Zone> zones, int right_time) =>
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            zones.get(i).b.set_right(right_time)

method overlaps_any(array<box> boxes, float top, float btm) =>
    bool hit = false
    if boxes.size() > 0
        for i = 0 to boxes.size() - 1
            box b = boxes.get(i)
            if top >= b.get_bottom() and btm <= b.get_top()
                hit := true
                break
    hit

// Hides every zone in the list. Used for timeframes below the chart timeframe.
method hide_all(array<Zone> zones, bool is_supply) =>
    color base = is_supply ? supply_color : demand_color
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            b.set_bgcolor(color.new(base, 100))
            b.set_border_color(color.new(base, 100))
            b.set_text("")

// Draw only the nearest show_n zones on this side. Hide the rest. White outline on the closest one if asked.
// With use_filter, a zone is eligible only if it overlaps one of the anchor boxes (the visible chart timeframe zones).
// Returns the boxes that ended up visible.
refresh(array<Zone> zones, bool is_supply, int slot, bool do_highlight, array<box> anchors, bool use_filter, bool hollow) =>
    [w, tr, nm] = zone_style(slot)
    color base = is_supply ? supply_color : demand_color
    array<box> shown_boxes = array.new<box>()
    int n = zones.size()
    if n > 0
        array<float> dist = array.new<float>(n, na)
        for i = 0 to n - 1
            box b = zones.get(i).b
            float d = is_supply ? (b.get_bottom() > close ? b.get_bottom() - close : (b.get_top() >= close ? 0.0 : na)) : (b.get_top() < close ? close - b.get_top() : (b.get_bottom() <= close ? 0.0 : na))
            if use_filter and not anchors.overlaps_any(b.get_top(), b.get_bottom())
                d := na
            dist.set(i, d)
            b.set_bgcolor(color.new(base, 100))
            b.set_border_color(color.new(base, 100))
            b.set_text("")
        int shown = 0
        while shown < show_n
            int best = -1
            float bd = na
            for i = 0 to n - 1
                float d = dist.get(i)
                if not na(d) and (na(bd) or d < bd)
                    bd := d
                    best := i
            if best < 0
                break
            box b = zones.get(best).b
            [bk, tag] = backing(slot, is_supply, b)
            bool is_target = shown == 0 and do_highlight
            int fill_tr = backing_fill and not hollow ? math.max(tr - 14 * bk, 30) : tr
            b.set_bgcolor(hollow ? color.new(base, 100) : color.new(base, fill_tr))
            // Higher timeframe frames: solid outline in the timeframe color. Chart timeframe: solid border in the zone color.
            color frame_col = slot == 2 ? monthly_color : weekly_color
            b.set_border_style(line.style_solid)
            b.set_text(is_target or label_targets_only ? "" : nm + (is_supply ? " SUPPLY" : " DEMAND"))
            if is_target
                b.set_border_color(highlight_color)
                b.set_border_width(3)
                mark_target(slot, is_supply, b, tag)
            else
                b.set_border_color(hollow ? frame_col : base)
                b.set_border_width(hollow ? 2 : w)
                if hollow
                    mark_frame(slot, is_supply, b)
            dist.set(best, na)
            shown_boxes.push(b)
            shown += 1
    shown_boxes

//-----------------------------------------------------------------------------
// MAIN LOGIC
//-----------------------------------------------------------------------------
process_slot(0, mode_d, show_d, sup_d, dem_d, d_sf, d_st, d_sb, d_stm, d_df, d_dt, d_db, d_dtm, d_c, d_h, d_l, d_a, d_sf_a, d_st_a, d_sb_a, d_stm_a, d_df_a, d_dt_a, d_db_a, d_dtm_a, d_c_a, d_h_a, d_l_a, d_a_a)
process_slot(1, mode_w, show_w, sup_w, dem_w, w_sf, w_st, w_sb, w_stm, w_df, w_dt, w_db, w_dtm, w_c, w_h, w_l, w_a, w_sf_a, w_st_a, w_sb_a, w_stm_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_c_a, w_h_a, w_l_a, w_a_a)
// Monthly is never lower than a Daily or Weekly chart, so it reuses the Weekly lower-tf arrays, which are ignored unless mode is 2
process_slot(2, mode_m, show_m, sup_m, dem_m, m_sf, m_st, m_sb, m_stm, m_df, m_dt, m_db, m_dtm, m_c, m_h, m_l, m_a, w_sf_a, w_st_a, w_sb_a, w_stm_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_c_a, w_h_a, w_l_a, w_a_a)

int future_time = time + (5 * timeframe.in_seconds() * 1000)
sup_d.extend_all(future_time)
dem_d.extend_all(future_time)
sup_w.extend_all(future_time)
dem_w.extend_all(future_time)
sup_m.extend_all(future_time)
dem_m.extend_all(future_time)

if barstate.islast
    while tgt_labels.size() > 0
        tgt_labels.pop().delete()
    // TARGET applies only to the chart timeframe, where the entry is taken
    bool hl_d = highlight_nearest and show_d and mode_d == 0
    bool hl_w = highlight_nearest and show_w and mode_w == 0
    bool hl_m = highlight_nearest and show_m and mode_m == 0
    // the anchor is the timeframe that matches the chart; below Daily, Daily is the anchor
    int anchor_slot = mode_d == 0 ? 0 : mode_w == 0 ? 1 : mode_m == 0 ? 2 : 0
    array<box> a_s = array.new<box>()
    array<box> a_d = array.new<box>()
    if anchor_slot == 0
        a_s := refresh(sup_d, true, 0, hl_d, a_s, false, false)
        a_d := refresh(dem_d, false, 0, hl_d, a_d, false, false)
    else if anchor_slot == 1
        a_s := refresh(sup_w, true, 1, hl_w, a_s, false, false)
        a_d := refresh(dem_w, false, 1, hl_w, a_d, false, false)
    else
        a_s := refresh(sup_m, true, 2, hl_m, a_s, false, false)
        a_d := refresh(dem_m, false, 2, hl_m, a_d, false, false)
    // Timeframes below the chart are never drawn: entries are taken on the chart timeframe, not inside it.
    // Timeframes above the chart follow the correlation rule.
    if anchor_slot != 0
        if mode_d == 2
            sup_d.hide_all(true)
            dem_d.hide_all(false)
        else
            refresh(sup_d, true, 0, hl_d, a_s, corr_only, hollow_htf)
            refresh(dem_d, false, 0, hl_d, a_d, corr_only, hollow_htf)
    if anchor_slot != 1
        if mode_w == 2
            sup_w.hide_all(true)
            dem_w.hide_all(false)
        else
            refresh(sup_w, true, 1, hl_w, a_s, corr_only, hollow_htf)
            refresh(dem_w, false, 1, hl_w, a_d, corr_only, hollow_htf)
    if anchor_slot != 2
        refresh(sup_m, true, 2, false, a_s, corr_only, hollow_htf)
        refresh(dem_m, false, 2, false, a_d, corr_only, hollow_htf)

//-----------------------------------------------------------------------------
// ZIG ZAG AND SWING LABELS (chart timeframe only)
//-----------------------------------------------------------------------------
float n_ph = ta.pivothigh(high, zz_len, zz_len)
float n_pl = ta.pivotlow(low, zz_len, zz_len)

if show_labels
    if not na(n_ph)
        label.new(bar_index[zz_len], n_ph, "High", style=label.style_label_down, color=color.new(color.white, 100), textcolor=label_color, size=size.tiny)
    if not na(n_pl)
        label.new(bar_index[zz_len], n_pl, "Low", style=label.style_label_up, color=color.new(color.white, 100), textcolor=label_color, size=size.tiny)

var line zz_line = na
var float last_zz_price = 0.0
var bool dir_up = false

if bar_index == 0
    last_zz_price := close

if show_zigzag
    bool is_high = not na(n_ph)
    bool is_low = not na(n_pl)

    if dir_up and is_high
        if n_ph > last_zz_price
            last_zz_price := n_ph
            if not na(zz_line)
                zz_line.set_xy2(bar_index[zz_len], last_zz_price)

    else if dir_up and is_low
        dir_up := false
        last_zz_price := n_pl
        if not na(zz_line)
            zz_line := line.new(zz_line.get_x2(), zz_line.get_y2(), bar_index[zz_len], last_zz_price, color=zigzag_color, width=2)

    else if not dir_up and is_low
        if n_pl < last_zz_price
            last_zz_price := n_pl
            if not na(zz_line)
                zz_line.set_xy2(bar_index[zz_len], last_zz_price)

    else if not dir_up and is_high
        dir_up := true
        last_zz_price := n_ph
        if not na(zz_line)
            zz_line := line.new(zz_line.get_x2(), zz_line.get_y2(), bar_index[zz_len], last_zz_price, color=zigzag_color, width=2)

    if na(zz_line) and (is_high or is_low)
        zz_line := line.new(bar_index, close, bar_index[zz_len], is_high ? n_ph : n_pl, color=zigzag_color, width=2)
