//@version=6
indicator("Jay S&D", overlay=true, max_bars_back=500, max_boxes_count=500, max_labels_count=500, max_lines_count=100)

//-----------------------------------------------------------------------------
// SETTINGS
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// TRADING STYLE: the three timeframes. Slot 0 = Low (entry zones, the targets), slot 1 = Mid (trend),
// slot 2 = High (range and backing). Matches the presets on the Zone Scorecard site.
//-----------------------------------------------------------------------------
string style_group = 'Trading Style'
string style = input.string('Position trader', 'Trading Style', options=['Position trader', 'Swing trader', 'Day trader', 'Scalper', 'Custom'], group=style_group, tooltip='Position: Daily / Weekly / Monthly. Swing: 4H / Daily / Weekly. Day trader: 15m / 1H / 4H. Scalper: 5m / 15m / 1H. Low is where the entry zones (targets) come from, Mid is the trend, High is the range and the backing. Custom uses the three inputs below.')
string tf_low_in = input.timeframe('D', 'Custom Low Timeframe', group=style_group)
string tf_mid_in = input.timeframe('W', 'Custom Mid Timeframe', group=style_group)
string tf_high_in = input.timeframe('M', 'Custom High Timeframe', group=style_group)
string TF0 = style == 'Position trader' ? 'D' : style == 'Swing trader' ? '240' : style == 'Day trader' ? '15' : style == 'Scalper' ? '5' : tf_low_in
string TF1 = style == 'Position trader' ? 'W' : style == 'Swing trader' ? 'D' : style == 'Day trader' ? '60' : style == 'Scalper' ? '15' : tf_mid_in
string TF2 = style == 'Position trader' ? 'M' : style == 'Swing trader' ? 'W' : style == 'Day trader' ? '240' : style == 'Scalper' ? '60' : tf_high_in

// Readable names: DAILY, WEEKLY, MONTHLY, 4H, 15M ...
tf_name(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec == timeframe.in_seconds("D") ? "DAILY" : sec == timeframe.in_seconds("W") ? "WEEKLY" : sec == timeframe.in_seconds("M") ? "MONTHLY" : sec % 3600 == 0 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "M"

// Short tags for the backing suffix: +W, +M, +4H ...
tf_tag(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec == timeframe.in_seconds("D") ? "D" : sec == timeframe.in_seconds("W") ? "W" : sec == timeframe.in_seconds("M") ? "M" : sec % 3600 == 0 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "M"

string poi_group = 'Zone Settings'
int max_zones = input.int(60, 'Max Zones Kept Per Timeframe', minval=2, group=poi_group, tooltip='Unbroken zones kept in memory per timeframe and side; the oldest is forgotten when the list is full. Only the nearest ones are drawn, see Zone Filters. Keep this high so an old base far below or above price is still there as a target when price finally returns to it.')
int typ_len = input.int(20, 'Typical Body Lookback', minval=5, group=poi_group, tooltip='Number of candles used to measure the typical candle body (the median, so a few crash candles do not distort it). Every size rule below is a multiple of this typical body, so the script scales itself to any market and timeframe.')
float impulse_mult = input.float(1.0, 'Impulse Min Body (x typical body)', minval=0.25, step=0.25, group=poi_group, tooltip='Floor for an impulse candle: its body must be at least this many typical bodies and move away from the base. The real test is relative: every base candle must be small compared with the impulse, see Base Candle Max.')
float base_mult = input.float(0.5, 'Base Candle Max (x impulse body)', minval=0.1, maxval=1.0, step=0.1, group=poi_group, tooltip='A candle counts as part of the base only if its body is at most this fraction of the impulse body. 0.5 means the impulse is at least twice every base candle.')
int base_max = input.int(4, 'Max Base Candles', minval=1, maxval=20, group=poi_group, tooltip='The base is the run of small candles immediately left of the impulse. Each one must share price with the candle right next to the impulse, so the walk stops where the pause started. Supply zone = base wick high to lowest base body. Demand zone = base wick low to highest base body.')
float box_width = input.float(1.0, 'Fallback Zone Width (x typical body)', step=0.25, group=poi_group, tooltip='Only used when the base has no height, for example a single doji with no wick.')
int zz_len = input.int(10, 'Zig Zag Swing Length', minval=1, group=poi_group, tooltip='A swing high must be the highest high of this many candles to its left (mirror for lows). Used by the zig zag and the trend readout.')
int zz_right = input.int(2, 'Swing Confirmation Bars', minval=1, group=poi_group, tooltip='How many candles must close after an extreme before it counts as a swing. Small keeps the swings and the trend readout current; large makes them more certain.')

string filt_group = 'Zone Filters'
bool use_departure = input.bool(true, 'Require Strong Departure', group=filt_group, tooltip='Keep a zone only if price left it by at least the departure multiple of the zone height within the given number of candles. This is the 2x move rule.')
float dep_mult = input.float(1.0, 'Departure (x zone height)', minval=0.25, step=0.25, group=filt_group, tooltip='Price must travel at least this many zone heights beyond the zone edge for the zone to count. Your 2x scoring rule still applies on the scorecard; this only decides whether a zone is drawn.')
int dep_bars = input.int(8, 'Departure Within (candles)', minval=1, maxval=20, group=filt_group, tooltip='A zone appears as soon as the impulse candle alone has departed this far, otherwise once the follow-through has, checked this many candles after the impulse.')
float max_height_mult = input.float(4.0, 'Max Zone Height (x typical body)', minval=0.5, step=0.5, group=filt_group, tooltip='Zones taller than this many typical bodies of their own timeframe are skipped.')
int max_touches = input.int(0, 'Remove Zone After N Touches', minval=0, group=filt_group, tooltip='A retest is price coming back into the zone after a candle closed back outside it. 0 = never remove by retests; purity is scored on the sheet instead.')
bool corr_only = input.bool(false, 'Hide Higher Timeframe Zones Without Correlation', group=filt_group, tooltip='Off: higher timeframe zones are drawn as hollow frames wherever they are, which shows where price is heading. On: they are drawn only where they overlap a chart timeframe zone of the same side. Zones from lower timeframes are never drawn either way.')
int show_n = input.int(3, 'Show Nearest Zones Per Side', minval=1, maxval=20, group=filt_group, tooltip='Per timeframe: draw only this many supply zones above price and demand zones below price. The rest stay in memory and appear when price moves toward them.')

string tf_group = 'Timeframes'
bool show_d = input.bool(true, 'Low timeframe zones (entry)', group=tf_group)
bool show_w = input.bool(true, 'Mid timeframe zones (trend)', group=tf_group)
bool show_m = input.bool(true, 'High timeframe zones (range)', group=tf_group)
bool highlight_nearest = input.bool(true, 'Outline Nearest Zones In White', group=tf_group, tooltip='On the chart timeframe, the closest supply above price and the closest demand below price get a white border and a TARGET label. Higher timeframe frames are never tagged as targets.')

string scan_group = 'Scanner'
int alert_min = input.int(14, 'Valid Setup Score', minval=0, maxval=20, group=scan_group, tooltip='A target zone whose automatic score reaches this is a valid setup on the board. The alert payload carries every score, so the board can show the rest too.')
bool alerts_on = input.bool(true, 'Send Setup Alerts', group=scan_group, tooltip='Fires alert() on every bar close with both target zones and their scores as JSON (an empty list when there is no target, so the board can see the alert is alive). Create one alert per symbol: condition Jay S&D, Any alert() function call, Once per bar close, with the webhook URL from the Zone Scorecard site. A 1H chart gives an hourly scan.')
bool show_score = input.bool(true, 'Show Score In Target Label', group=scan_group, tooltip='Adds a SCORE line to each target label with the indicator\'s own point estimate for every check.')
float approach_pct = input.float(0.8, 'Approach Alert At (share of the way)', minval=0.1, maxval=0.99, step=0.05, group=scan_group, tooltip='Fires the "Price near a target zone" alert condition when price has covered this share of the distance between the two target zones, heading into one of them. Create a separate alert for it with sound on.')
string visual_group = 'Visual Settings'
color sup_d_col = input.color(#FF6B6B, 'Low TF Supply / Demand', group=visual_group, inline='sd')
color sup_w_col = input.color(#E03131, 'Mid TF Supply / Demand', group=visual_group, inline='sw')
color sup_m_col = input.color(#8B0000, 'High TF Supply / Demand', group=visual_group, inline='sm')
color dem_d_col = input.color(#69DB7C, '', group=visual_group, inline='sd', tooltip='Low timeframe supply and demand colors.')
color dem_w_col = input.color(#089981, '', group=visual_group, inline='sw', tooltip='Mid timeframe supply and demand colors.')
color dem_m_col = input.color(#004D40, '', group=visual_group, inline='sm', tooltip='High timeframe supply and demand colors.')
int transp_d = input.int(78, 'Low TF Fill Transparency', minval=0, maxval=100, group=visual_group)
int transp_w = input.int(70, 'Mid TF Fill Transparency', minval=0, maxval=100, group=visual_group)
int transp_m = input.int(60, 'High TF Fill Transparency', minval=0, maxval=100, group=visual_group)
int width_d = input.int(30, 'Low TF Zone Width (bars)', minval=2, group=visual_group, tooltip='How many chart bars wide each zone is drawn, measured back from the last candle. Daily shortest, Weekly longer, Monthly longest, so a stack of zones shows its correlation by size.')
int width_w = input.int(60, 'Mid TF Zone Width (bars)', minval=2, group=visual_group)
int width_m = input.int(90, 'High TF Zone Width (bars)', minval=2, group=visual_group)
bool anchor_base = input.bool(true, 'Anchor Zones To Their Base Candle', group=visual_group, tooltip='On: each zone starts at the base candle it was built from, like the original drawing. Off: zones use the widths above and end at the right margin.')
color go_color = input.color(#2ECC71, 'Go Label Color', group=visual_group, tooltip='The target label turns this color when the trade is a go: score at or above the valid score, and price is retesting the zone now (or the impulse gapped away from the base, the one case that needs no retest).')
color highlight_color = input.color(color.white, 'Nearest Zone Outline', group=visual_group)
int target_tr = input.int(40, 'Target Zone Fill Transparency', minval=0, maxval=100, group=visual_group, tooltip='The two target zones (white outline) use this fill transparency instead of their timeframe value, so they stand out boldly.')
color label_color = input.color(color.white, 'Text Color', group=visual_group)
bool show_zigzag = input.bool(false, 'Show Zig Zag (chart timeframe)', group=visual_group)
bool show_trend = input.bool(true, 'Show Trend Readout', group=visual_group, tooltip='A box in the top right corner with the trend state of the Trend Timeframe and of the chart timeframe, read from the zig zag swings with the 3 segment rule: higher highs and higher lows is UP, lower highs and lower lows is DOWN, anything else is RANGE. The control point is the last higher low (up) or lower high (down); a close through it ends the trend.')
bool trend_auto = input.bool(true, 'Trend Readout Uses The Mid Timeframe', group=visual_group, tooltip='On: the readout scores the trend of the style\'s Mid timeframe. Off: it uses the Trend Timeframe below.')
string trend_tf_in = input.timeframe('W', 'Trend Timeframe (when not automatic)', group=visual_group)
string trend_tf = trend_auto ? TF1 : trend_tf_in
bool show_labels = input.bool(false, 'Show Swing Labels (chart timeframe)', group=visual_group)
color zigzag_color = input.color(color.gray, 'ZigZag Color', group=visual_group)
bool show_zone_info = input.bool(false, 'Zone Facts On Every Box', group=visual_group, tooltip='Prints price range, base candle count, base date and origin (own base, gap refined, or read from the timeframe below) inside every drawn box. For checking a zone against the rules.')
bool label_targets_only = input.bool(true, 'Label Only The Target Zones', group=visual_group, tooltip='Only the white outlined zones (the nearest on each side) get a label: timeframe, side, price range and the word TARGET, placed in the margin right of the last candle. Other boxes stay unlabeled. Turn off to also print timeframe and side inside every box.')

//-----------------------------------------------------------------------------
// TYPES, ARRAYS & GLOBALS
//-----------------------------------------------------------------------------
type Zone
    box b
    int touches = 0
    bool inside = false
    int base_n = 0        // number of base candles the zone was built from
    float depth = 0.0     // deepest retest so far, as a fraction of the zone height (0 to 1)
    bool os = false       // oppositional structure: the move out of the zone, before any retest, closed through an opposing zone of the same timeframe
    int lt = 0            // time of the base's first candle
    bool via_lower = false // zone drawn from the base seen one timeframe below, inside a higher timeframe turn with no clean base
    float ext = na        // furthest price the move out reached before the first retest
    bool gap = false      // the base walk stopped at a price gap, so the zone covers only the candles on the impulse side of it
    bool gap_out = false  // the impulse opened away from the base with a gap: the one case where the trade is a go before any retest
    float chk = na        // drill-down only: the furthest close of this timeframe seen between the base and the turn (for checking the rule)

// slot 0 = Daily, 1 = Weekly, 2 = Monthly
var array<Zone> sup_d = array.new<Zone>()
var array<Zone> dem_d = array.new<Zone>()
var array<Zone> sup_w = array.new<Zone>()
var array<Zone> dem_w = array.new<Zone>()
var array<Zone> sup_m = array.new<Zone>()
var array<Zone> dem_m = array.new<Zone>()
var array<box> broken_zones = array.new<box>()
var array<label> tgt_labels = array.new<label>()   // right-margin labels for the target zones, rebuilt on every refresh
// the target zones picked on the last bar (arrays, because functions may not assign globals), labeled and scored after the trend readout is known
var array<Zone> tgt_zones = array.new<Zone>()
var array<bool> tgt_is_sup = array.new<bool>()
var array<string> tgt_tags = array.new<string>()
var array<int> tgt_slots = array.new<int>()
// record of zone breaks: bar time and key (slot * 2 + side), so a new zone can tell whether its move out broke an opposing zone
var array<int> brk_t = array.new<int>()
var array<int> brk_k = array.new<int>()
var array<int> brk_lt = array.new<int>()   // base time of the zone that broke
// higher timeframe turns that had an impulse but no clean base, waiting for the timeframe below to supply the base
var array<int> pt_key = array.new<int>()     // slot * 2 + side
var array<int> pt_t0 = array.new<int>()      // window start (two candles before the impulse)
var array<int> pt_t1 = array.new<int>()      // window end (close of the impulse candle)
var array<float> pt_ext = array.new<float>() // the extreme price of the turn
var array<int> turn_seen = array.new<int>()
// keys of bases already turned into zones (left_time * 8 + slot * 2 + side), so a repeated report is not drawn twice
var array<int> seen_keys = array.new<int>()

int chart_sec = timeframe.in_seconds()

// mode per slot: 0 = same as chart, 1 = higher than chart, 2 = lower than chart
f_mode(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec == chart_sec ? 0 : sec > chart_sec ? 1 : 2

int mode_d = f_mode(TF0)
int mode_w = f_mode(TF1)
int mode_m = f_mode(TF2)

//-----------------------------------------------------------------------------
// BASE DETECTION (runs inside each timeframe's own context)
//-----------------------------------------------------------------------------
// Looks at the candle k bars back. If it is an impulse (big body, moving away from the base),
// walks left over the small overlapping candles that form the base and returns the zone.
// Supply = base wick high down to the lowest base body. Demand = base wick low up to the highest base body.
// Returns [found, top, btm, left_time, base_count, impulse_time, turn, turn_t0, turn_t1, turn_extreme].
// turn is true when the impulse qualified but no clean base did: the timeframe below is then asked for the base.
detect(bool is_supply, int k, float yard) =>
    float lim = yard * impulse_mult
    bool found = false
    float z_top = na
    float z_btm = na
    int lt = na
    int cnt = 0
    bool turn = false
    bool gap_cut = false
    int t_t0 = na
    int t_t1 = na
    float t_ext = na
    float body = math.abs(close[k] - open[k])
    bool away = is_supply ? close[k] < open[k] : close[k] > open[k]
    // a gap between this candle and the one before it is part of the impulse: price left the base without trading
    // there, so the gap counts as impulsive movement (the sheet's rule) and a gap alone can be the impulse.
    // The gap is measured at the open against the previous candle's body, the way it shows on the chart; a wick
    // that later dips back into the gap does not undo it
    float prev_top = math.max(open[k + 1], close[k + 1])
    float prev_btm = math.min(open[k + 1], close[k + 1])
    float gap_in = is_supply ? math.max(prev_btm - open[k], 0.0) : math.max(open[k] - prev_top, 0.0)
    bool gap_imp = gap_in > 0
    // a full gap: the impulse opened beyond the previous candle's wick, so price never traded back at the base's edge.
    // This is the "gap away from the zone" that allows an entry before any retest; a gap that only clears the body does not
    bool gap_full = is_supply ? open[k] < low[k + 1] : open[k] > high[k + 1]
    float drive = body + nz(gap_in)
    if not na(body) and drive >= lim and (away or gap_imp)
        float base_lim = drive * base_mult
        float a_lo = na   // full range of the first base candle, the one next to the impulse
        float a_hi = na
        float w_lo = na   // running wick extremes of the base
        float w_hi = na
        for j = 1 to base_max
            int off = k + j
            float bd = math.abs(close[off] - open[off])
            float bh = math.max(open[off], close[off])
            float bl = math.min(open[off], close[off])
            // the candle a gap left behind is the base whatever its size: the gap itself is the proof of imbalance
            if na(bd) or (bd > base_lim and not (j == 1 and gap_imp))
                break
            // a gap between two base candles ends the base: only the candles on the impulse side of the gap are the
            // zone (gap refined), as the sheet draws it. A gap is the later candle opening outside the earlier
            // candle's body, the space you see between bodies on the chart. The gap itself is impulsive movement
            if cnt > 0 and (open[off - 1] > math.max(open[off], close[off]) or open[off - 1] < math.min(open[off], close[off]))
                gap_cut := true
                break
            if cnt > 0 and (bh < a_lo or bl > a_hi)
                break
            if cnt == 0
                a_lo := low[off]
                a_hi := high[off]
            cnt += 1
            w_lo := na(w_lo) ? low[off] : math.min(w_lo, low[off])
            w_hi := na(w_hi) ? high[off] : math.max(w_hi, high[off])
            z_top := is_supply ? w_hi : (na(z_top) ? bh : math.max(z_top, bh))
            z_btm := is_supply ? (na(z_btm) ? bl : math.min(z_btm, bl)) : w_lo
            lt := time[off]
        // V-shaped turn: no small base, but the candle next to the impulse holds the extreme.
        // That candle is the base on its own, wick to body, as long as the impulse (body plus any gap) is at
        // least as big as it. A candle bigger than the impulse is a drive, not a base. This is how the sheet
        // draws a one candle base at a V low or V high.
        if cnt == 0
            int off = k + 1
            bool holds_extreme = is_supply ? high[off] >= high[k] : low[off] <= low[k]
            bool normal_size = gap_imp or math.abs(close[off] - open[off]) <= drive
            if not na(close[off]) and holds_extreme and normal_size
                z_top := is_supply ? high[off] : math.max(open[off], close[off])
                z_btm := is_supply ? math.min(open[off], close[off]) : low[off]
                lt := time[off]
                cnt := 1
        if cnt > 0
            found := true
        else
            turn := true
            t_t0 := na(time[k + 2]) ? time[k + 1] : time[k + 2]
            t_t1 := time_close[k]
            t_ext := is_supply ? math.max(high[k], nz(high[k + 1], high[k])) : math.min(low[k], nz(low[k + 1], low[k]))
    [found, z_top, z_btm, lt, cnt, time[k], turn, t_t0, t_t1, t_ext, gap_cut, gap_full and found]

// True when price travelled at least dep_mult x zone height beyond the zone edge over the k closed candles starting at the impulse.
departs(bool is_supply, int k, float top, float btm, float yard) =>
    bool ok = false
    float need = (top - btm) * dep_mult
    if not na(top) and not na(btm) and k >= 1
        float ext = na
        for i = 1 to k
            int off = k - i + 1
            ext := is_supply ? (na(ext) ? low[off] : math.min(ext, low[off])) : (na(ext) ? high[off] : math.max(ext, high[off]))
        ok := is_supply ? ext <= btm - need : ext >= top + need
    ok

// One candidate per side per bar: an impulse that closed last bar and already departed far enough,
// otherwise an impulse dep_bars ago whose follow-through has now departed far enough.
candidate(bool is_supply, float yard) =>
    [f1, t1, b1, l1, n1, i1, tn1, a1, c1, x1, g1, o1] = detect(is_supply, 1, yard)
    bool dep1 = departs(is_supply, 1, t1, b1, yard)
    bool ok1 = f1 and (not use_departure or dep1)
    [f2, t2, b2, l2, n2, i2, tn2, a2, c2, x2, g2, o2] = detect(is_supply, dep_bars, yard)
    bool dep2 = departs(is_supply, dep_bars, t2, b2, yard)
    bool ok2 = f2 and (not use_departure or dep2)
    // a zone found late (impulse dep_bars ago) is dead on arrival if any candle since the impulse closed through its far edge
    if ok2
        for i = 1 to dep_bars - 1
            if is_supply ? close[i] > t2 : close[i] < b2
                ok2 := false
                break
    bool found = ok1 or ok2
    float top = ok1 ? t1 : t2
    float btm = ok1 ? b1 : b2
    int lt = ok1 ? l1 : l2
    int n = ok1 ? n1 : n2
    int it = ok1 ? i1 : i2
    bool gp = ok1 ? g1 : g2
    bool go = ok1 ? o1 : o2
    // a turn with no clean base counts only once price has departed from the extreme like a zone would
    bool td1 = tn1 and (not use_departure or departs(is_supply, 1, is_supply ? x1 : x1 + yard, is_supply ? x1 - yard : x1, yard))
    bool td2 = tn2 and (not use_departure or departs(is_supply, dep_bars, is_supply ? x2 : x2 + yard, is_supply ? x2 - yard : x2, yard))
    bool turn = not found and (td1 or td2)
    int tt0 = td1 ? a1 : a2
    int tt1 = td1 ? c1 : c2
    float tx = td1 ? x1 : x2
    [found, top, btm, lt, n, it, turn, tt0, tt1, tx, gp, go]

// Everything a timeframe reports each bar.
tf_pack() =>
    float yard = ta.median(math.abs(close - open), typ_len)
    [s_f, s_top, s_btm, s_t, s_n, s_i, s_tn, s_a, s_c, s_x, s_g, s_o] = candidate(true, yard)
    [d_f, d_top, d_btm, d_t, d_n, d_i, d_tn, d_a, d_c, d_x, d_g, d_o] = candidate(false, yard)
    [s_f, s_top, s_btm, s_t, s_n, s_i, d_f, d_top, d_btm, d_t, d_n, d_i, close, high, low, yard, s_tn, s_a, s_c, s_x, d_tn, d_a, d_c, d_x, s_g, d_g, s_o, d_o]

//-----------------------------------------------------------------------------
// DATA REQUESTS
// Higher or equal timeframes use request.security. Lower timeframes (for example
// Daily zones on a Weekly chart) use request.security_lower_tf. A slot that does
// not apply just requests the chart timeframe and is ignored later.
//-----------------------------------------------------------------------------
string tf_d_hi = mode_d == 1 ? TF0 : timeframe.period
string tf_w_hi = mode_w == 1 ? TF1 : timeframe.period
string tf_m_hi = mode_m == 1 ? TF2 : timeframe.period
string tf_d_lo = mode_d == 2 ? TF0 : timeframe.period
string tf_w_lo = mode_w == 2 ? TF1 : timeframe.period
// Lower-timeframe requests return 24 arrays per bar, which TradingView lists as the heaviest thing a script can hold in
// memory. On a chart that needs no drill-down (every alert chart) they are cut to a handful of bars so the alert server
// does not run out of memory and stop the alert with a calculation error.
// (computed inline because calc_bars_count needs a simple int, and a user function would return a series)
int lo_bars_d = timeframe.in_seconds(TF0) < chart_sec ? 100000 : 5
int lo_bars_w = timeframe.in_seconds(TF1) < chart_sec ? 100000 : 5

[d_sf, d_st, d_sb, d_stm, d_sn, d_si, d_df, d_dt, d_db, d_dtm, d_dn, d_di, d_c, d_h, d_l, d_a, d_stn, d_st0, d_st1, d_stx, d_dtn, d_dt0, d_dt1, d_dtx, d_sg, d_dg, d_so, d_do] = request.security(syminfo.tickerid, tf_d_hi, tf_pack())
[w_sf, w_st, w_sb, w_stm, w_sn, w_si, w_df, w_dt, w_db, w_dtm, w_dn, w_di, w_c, w_h, w_l, w_a, w_stn, w_st0, w_st1, w_stx, w_dtn, w_dt0, w_dt1, w_dtx, w_sg, w_dg, w_so, w_do] = request.security(syminfo.tickerid, tf_w_hi, tf_pack())
[m_sf, m_st, m_sb, m_stm, m_sn, m_si, m_df, m_dt, m_db, m_dtm, m_dn, m_di, m_c, m_h, m_l, m_a, m_stn, m_st0, m_st1, m_stx, m_dtn, m_dt0, m_dt1, m_dtx, m_sg, m_dg, m_so, m_do] = request.security(syminfo.tickerid, tf_m_hi, tf_pack())

[d_sf_a, d_st_a, d_sb_a, d_stm_a, d_sn_a, d_si_a, d_df_a, d_dt_a, d_db_a, d_dtm_a, d_dn_a, d_di_a, d_c_a, d_h_a, d_l_a, d_a_a, d_stn_a, d_st0_a, d_st1_a, d_stx_a, d_dtn_a, d_dt0_a, d_dt1_a, d_dtx_a, d_sg_a, d_dg_a, d_so_a, d_do_a] = request.security_lower_tf(syminfo.tickerid, tf_d_lo, tf_pack(), calc_bars_count=lo_bars_d)
[w_sf_a, w_st_a, w_sb_a, w_stm_a, w_sn_a, w_si_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_dn_a, w_di_a, w_c_a, w_h_a, w_l_a, w_a_a, w_stn_a, w_st0_a, w_st1_a, w_stx_a, w_dtn_a, w_dt0_a, w_dt1_a, w_dtx_a, w_sg_a, w_dg_a, w_so_a, w_do_a] = request.security_lower_tf(syminfo.tickerid, tf_w_lo, tf_pack(), calc_bars_count=lo_bars_w)

//-----------------------------------------------------------------------------
// ZONE FUNCTIONS
//-----------------------------------------------------------------------------
zone_style(int slot) =>
    int w = slot == 2 ? 2 : 1
    int tr = slot == 2 ? transp_m : slot == 1 ? transp_w : transp_d
    string nm = tf_name(slot == 2 ? TF2 : slot == 1 ? TF1 : TF0)
    [w, tr, nm]

zone_color(int slot, bool is_supply) =>
    is_supply ? (slot == 2 ? sup_m_col : slot == 1 ? sup_w_col : sup_d_col) : (slot == 2 ? dem_m_col : slot == 1 ? dem_w_col : dem_d_col)

zone_width(int slot) =>
    slot == 2 ? width_m : slot == 1 ? width_w : width_d

// true when any zone in the list overlaps the price range
method any_overlap(array<Zone> zones, float top, float btm) =>
    bool hit = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box ob = zones.get(i).b
            if top >= ob.get_bottom() and btm <= ob.get_top()
                hit := true
                break
    hit

// Higher timeframe backing for a zone of the given slot: returns [count, tag] such as [2, " +W +M"].
backing(int slot, bool is_supply, box b) =>
    float top = b.get_top()
    float btm = b.get_bottom()
    int cnt = 0
    string tag = ""
    if slot < 1 and show_w
        if (is_supply ? sup_w : dem_w).any_overlap(top, btm)
            cnt += 1
            tag := tag + " +" + tf_tag(TF1)
    if slot < 2 and show_m
        if (is_supply ? sup_m : dem_m).any_overlap(top, btm)
            cnt += 1
            tag := tag + " +" + tf_tag(TF2)
    [cnt, tag]

// Label text: timeframe, side, price range, TARGET, higher timeframe backing, then the facts the scorer needs:
// base candle count, retest count with the deepest retest as a share of the zone, and oppositional structure.
zone_text(int slot, bool is_supply, Zone z, string tag, string extra, string status) =>
    [w, tr, nm] = zone_style(slot)
    box b = z.b
    // three short lines keep the label narrow enough to clear the price axis
    string facts = "base " + str.tostring(z.base_n) + " | touches " + str.tostring(z.touches) + (z.touches > 0 ? " (" + str.tostring(math.round(z.depth * 100)) + "% deep)" : "") + " | OS " + (z.os ? "yes" : "no") + (z.gap ? " | gap refined" : "") + (z.via_lower ? " | base read on " + tf_name(slot == 2 ? TF1 : TF0) : "")
    nm + (is_supply ? " SUPPLY" : " DEMAND") + " " + str.tostring(b.get_bottom(), format.mintick) + " - " + str.tostring(b.get_top(), format.mintick) + "\nTARGET" + tag + (status == "" ? "" : " | " + status) + "\n" + facts + (extra != "" ? "\n" + extra : "")

// Puts the target label in the empty space to the right of the last candle, where no candle can cover it.
mark_target(int slot, bool is_supply, Zone z, string tag, string extra, string status, bool go) =>
    box b = z.b
    float mid = (b.get_top() + b.get_bottom()) / 2
    // just outside the box's right end, extending into the right margin. Green when the trade is a go
    label l = label.new(bar_index + 6, mid, zone_text(slot, is_supply, z, tag, extra, status), xloc=xloc.bar_index, style=label.style_label_left, color=go ? go_color : highlight_color, textcolor=color.black, size=size.small)
    tgt_labels.push(l)

method trim(array<Zone> zones, int limit) =>
    while zones.size() > limit
        Zone z = zones.pop()
        z.b.delete()

// true when the new price range touches an existing zone of the same timeframe and side
method overlaps(array<Zone> zones, float top, float btm) =>
    bool hit = false
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            if top >= b.get_bottom() and btm <= b.get_top()
                hit := true
                break
    hit

// True when an opposing zone of the same timeframe broke during the move out of this base: a recorded break
// on the opposite side, between the base's first candle and the impulse candle (one chart bar of slack each way).
broke_opposing(int slot, bool is_supply, int left_time, int imp_t) =>
    bool hit = false
    int key = slot * 2 + (is_supply ? 1 : 0)
    int slack = timeframe.in_seconds() * 1000
    if brk_t.size() > 0 and not na(left_time)
        int hi = na(imp_t) ? time : imp_t
        for i = 0 to brk_t.size() - 1
            if brk_k.get(i) == key and brk_lt.get(i) < left_time and brk_t.get(i) >= left_time - slack and brk_t.get(i) <= hi + slack
                hit := true
                break
    hit

// z_top, z_btm = zone edges from the base
// yard_tf = typical (median) candle body of the zone's own timeframe
// n = number of base candles, imp_t = time of the impulse candle
create_zone(array<Zone> zones, bool is_supply, float z_top, float z_btm, int left_time, int slot, float yard_tf, int n, int imp_t, bool gp, bool go, bool from_lower) =>
    float buffer = yard_tf * box_width
    bool flat = na(z_top) or na(z_btm) or (z_top - z_btm) <= syminfo.mintick
    float anchor = is_supply ? z_top : z_btm
    float top = flat ? (is_supply ? anchor : anchor + buffer) : z_top
    float btm = flat ? (is_supply ? anchor - buffer : anchor) : z_btm
    bool ok = not na(top) and not na(btm)
    if (top - btm) > max_height_mult * yard_tf
        ok := false
    // A zone read from the timeframe's own base replaces an overlapping zone when that zone is a drill-down guess,
    // a later base, or an older zone that price has already come back to test. A fresh base formed on the retest
    // of an old zone is the zone to trade from then on (the sheet marks the newer, tighter base). An untested older
    // zone is kept and the newcomer skipped: a base formed during the first move out of a zone is a continuation
    // inside that move, not a new zone of the same price
    if ok and not from_lower and zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone oz = zones.get(i)
            bool over = top >= oz.b.get_bottom() and btm <= oz.b.get_top()
            if over and (oz.via_lower or oz.lt >= left_time or oz.touches > 0)
                oz.b.delete()
                zones.remove(i)
    if ok and not zones.overlaps(top, btm)
        [w, tr, nm] = zone_style(slot)
        color base = zone_color(slot, is_supply)
        box b = box.new(left_time, top, time, btm, xloc=xloc.bar_time, border_color=base, border_width=w, bgcolor=color.new(base, tr), text="", text_color=label_color, text_size=size.small, text_halign=slot == 0 ? text.align_right : slot == 1 ? text.align_center : text.align_left, text_valign=text.align_center, extend=extend.none)
        Zone z = Zone.new(b)
        z.base_n := n
        z.lt := left_time
        z.gap := gp
        z.gap_out := go
        z.os := broke_opposing(slot, is_supply, left_time, imp_t)
        zones.unshift(z)
        zones.trim(max_zones)

// Break: a candle of the zone's own timeframe closes through the wick edge.
// Retest: price comes back into the zone after a candle closed back outside it. Consecutive candles inside the zone
// are one visit. A candle that wicks in and closes outside ends the visit, so the next entry is a new retest.
monitor(array<Zone> zones, bool is_supply, int slot, float c, float h, float l) =>
    if zones.size() > 0 and not na(c)
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            box b = z.b
            float limit_level = is_supply ? b.get_top() : b.get_bottom()
            bool broken = is_supply ? c >= limit_level : c <= limit_level
            if broken
                box bos = b.copy()
                float mid = (b.get_top() + b.get_bottom()) / 2
                bos.set_top(mid)
                bos.set_bottom(mid)
                bos.set_bgcolor(color.new(color.white, 100))
                bos.set_border_color(color.new(color.white, 80))
                bos.set_border_width(1)
                bos.set_text("")
                bos.set_extend(extend.none)
                bos.set_right(time)
                broken_zones.unshift(bos)
                if broken_zones.size() > 10
                    broken_zones.pop().delete()
                brk_t.unshift(time)
                brk_k.unshift(slot * 2 + (is_supply ? 0 : 1))
                brk_lt.unshift(z.lt)
                if brk_t.size() > 300
                    brk_t.pop()
                    brk_k.pop()
                    brk_lt.pop()
                b.delete()
                zones.remove(i)
                continue
            bool touching = is_supply ? h >= b.get_bottom() : l <= b.get_top()
            bool closed_out = is_supply ? c < b.get_bottom() : c > b.get_top()
            if z.touches == 0
                z.ext := is_supply ? (na(z.ext) ? l : math.min(z.ext, l)) : (na(z.ext) ? h : math.max(z.ext, h))
            if touching and not z.inside
                z.touches += 1
            if touching
                float hgt = b.get_top() - b.get_bottom()
                if hgt > 0
                    float pen = is_supply ? (h - b.get_bottom()) / hgt : (b.get_top() - l) / hgt
                    z.depth := math.max(z.depth, math.min(math.max(pen, 0.0), 1.0))
            z.inside := touching and not closed_out
            if max_touches > 0 and z.touches > max_touches
                b.delete()
                zones.remove(i)

// Adds a reported base as a zone once, keyed by its leftmost candle time.
add_once(array<Zone> zones, bool is_supply, int slot, bool found, float top, float btm, int lt, int n, int imp_t, float atr_tf, bool gp, bool go) =>
    if found and not na(lt)
        int key = lt * 8 + slot * 2 + (is_supply ? 0 : 1)
        if seen_keys.indexof(key) < 0
            seen_keys.unshift(key)
            if seen_keys.size() > 400
                seen_keys.pop()
            create_zone(zones, is_supply, top, btm, lt, slot, atr_tf, n, imp_t, gp, go, false)

// Oppositional structure covers the whole directional move out of the zone, not just the impulse candle:
// until the zone's first retest, any close through an opposing zone of the same timeframe that already existed
// to the left of the base sets the flag. Zones born during the move itself do not count.
method update_os(array<Zone> zones, bool is_supply, int slot) =>
    if zones.size() > 0 and brk_t.size() > 0
        int key = slot * 2 + (is_supply ? 1 : 0)
        int slack = timeframe.in_seconds() * 1000
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if not z.os and z.touches == 0
                for j = 0 to brk_t.size() - 1
                    int bt = brk_t.get(j)
                    if bt < z.lt - slack
                        break
                    if brk_k.get(j) == key and brk_lt.get(j) < z.lt
                        z.os := true
                        break

// Records a higher timeframe turn that had no clean base.
note_turn(int slot, bool is_supply, bool tn, int t0, int t1, float ext) =>
    if slot > 0 and tn and not na(t0) and not na(t1)
        int key = t0 * 8 + slot * 2 + (is_supply ? 0 : 1)
        if turn_seen.indexof(key) < 0
            turn_seen.unshift(key)
            if turn_seen.size() > 200
                turn_seen.pop()
            pt_key.unshift(slot * 2 + (is_supply ? 0 : 1))
            pt_t0.unshift(t0)
            pt_t1.unshift(t1)
            pt_ext.unshift(ext)

// Drops one timeframe to read the base: a zone of the timeframe below whose base sits inside the turn window
// and at the turn's extreme is drawn back as a zone of this timeframe. Pending turns expire after 12 of their candles.
resolve_turns(int slot, bool is_supply, array<Zone> zones, float yard_h, float tf_close) =>
    if slot > 0 and pt_key.size() > 0
        int key = slot * 2 + (is_supply ? 0 : 1)
        array<Zone> lower = slot == 2 ? (is_supply ? sup_w : dem_w) : (is_supply ? sup_d : dem_d)
        int life = timeframe.in_seconds(slot == 2 ? TF2 : TF1) * 1000 * 12
        for i = pt_key.size() - 1 to 0
            if pt_key.get(i) == key
                int t0 = pt_t0.get(i)
                int t1 = pt_t1.get(i)
                float ext = pt_ext.get(i)
                bool done = false
                if lower.size() > 0
                    for j = 0 to lower.size() - 1
                        Zone lz = lower.get(j)
                        box lb = lz.b
                        bool in_window = lz.lt >= t0 and lz.lt <= t1
                        bool at_extreme = is_supply ? lb.get_top() >= ext - yard_h : lb.get_bottom() <= ext + yard_h
                        // a candle of this timeframe that already closed through the base kills it before it is drawn
                        bool dead = false
                        float far = na
                        if in_window and at_extreme
                            for q = 1 to 120
                                if time_close[q] <= lz.lt
                                    break
                                far := is_supply ? (na(far) ? tf_close[q] : math.max(far, tf_close[q])) : (na(far) ? tf_close[q] : math.min(far, tf_close[q]))
                                if is_supply ? tf_close[q] > lb.get_top() : tf_close[q] < lb.get_bottom()
                                    dead := true
                                    break
                        if in_window and at_extreme and not dead
                            int before = zones.size()
                            create_zone(zones, is_supply, lb.get_top(), lb.get_bottom(), lz.lt, slot, yard_h, lz.base_n, t1, lz.gap, lz.gap_out, true)
                            if zones.size() > before
                                Zone pz = zones.get(0)
                                pz.via_lower := true
                                pz.chk := far
                            done := true
                            break
                if done or time > t1 + life
                    pt_key.remove(i)
                    pt_t0.remove(i)
                    pt_t1.remove(i)
                    pt_ext.remove(i)

process_slot(int slot, int mode, bool show, array<Zone> sup, array<Zone> dem, bool h_sf, float h_st, float h_sb, int h_stm, int h_sn, int h_si, bool h_df, float h_dt, float h_db, int h_dtm, int h_dn, int h_di, float h_c, float h_h, float h_l, float h_a, array<bool> l_sf, array<float> l_st, array<float> l_sb, array<int> l_stm, array<int> l_sn, array<int> l_si, array<bool> l_df, array<float> l_dt, array<float> l_db, array<int> l_dtm, array<int> l_dn, array<int> l_di, array<float> l_c, array<float> l_h, array<float> l_l, array<float> l_a, bool h_stn, int h_st0, int h_st1, float h_stx, bool h_dtn, int h_dt0, int h_dt1, float h_dtx, bool h_sg, bool h_dg, array<bool> l_sg, array<bool> l_dg, bool h_so, bool h_do, array<bool> l_so, array<bool> l_do) =>
    if show
        if mode == 2
            if l_c.size() > 0
                for i = 0 to l_c.size() - 1
                    add_once(sup, true, slot, l_sf.get(i), l_st.get(i), l_sb.get(i), l_stm.get(i), l_sn.get(i), l_si.get(i), l_a.get(i), l_sg.get(i), l_so.get(i))
                    add_once(dem, false, slot, l_df.get(i), l_dt.get(i), l_db.get(i), l_dtm.get(i), l_dn.get(i), l_di.get(i), l_a.get(i), l_dg.get(i), l_do.get(i))
                    monitor(sup, true, slot, l_c.get(i), l_h.get(i), l_l.get(i))
                    monitor(dem, false, slot, l_c.get(i), l_h.get(i), l_l.get(i))
                sup.update_os(true, slot)
                dem.update_os(false, slot)
            0
        else
            add_once(sup, true, slot, h_sf, h_st, h_sb, h_stm, h_sn, h_si, h_a, h_sg, h_so)
            add_once(dem, false, slot, h_df, h_dt, h_db, h_dtm, h_dn, h_di, h_a, h_dg, h_do)
            monitor(sup, true, slot, h_c, h_h, h_l)
            monitor(dem, false, slot, h_c, h_h, h_l)
            sup.update_os(true, slot)
            dem.update_os(false, slot)
            note_turn(slot, true, h_stn, h_st0, h_st1, h_stx)
            note_turn(slot, false, h_dtn, h_dt0, h_dt1, h_dtx)
            resolve_turns(slot, true, sup, h_a, h_c)
            resolve_turns(slot, false, dem, h_a, h_c)
            0

// Sizes every box: either anchored at its base candle and extended to the right margin, or a fixed
// width per timeframe measured back from the last candle (Daily shortest, Monthly longest).
method size_all(array<Zone> zones, int slot, int right_time) =>
    if zones.size() > 0
        int left_bar = math.max(bar_index - zone_width(slot), 0)
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            if anchor_base
                b.set_right(right_time)
            else
                b.set_xloc(left_bar, bar_index + 5, xloc.bar_index)

method overlaps_any(array<box> boxes, float top, float btm) =>
    bool hit = false
    if boxes.size() > 0
        for i = 0 to boxes.size() - 1
            box b = boxes.get(i)
            if top >= b.get_bottom() and btm <= b.get_top()
                hit := true
                break
    hit

// Hides every zone in the list. Used for timeframes below the chart timeframe.
method hide_all(array<Zone> zones, bool is_supply, int slot) =>
    color base = zone_color(slot, is_supply)
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            b.set_bgcolor(color.new(base, 100))
            b.set_border_color(color.new(base, 100))
            b.set_text("")

// Draw only the nearest show_n zones on this side. Hide the rest. White outline on the closest one if asked.
// With use_filter, a zone is eligible only if it overlaps one of the anchor boxes (the visible chart timeframe zones).
// Returns the boxes that ended up visible.
refresh(array<Zone> zones, bool is_supply, int slot, bool do_highlight, array<box> anchors, bool use_filter) =>
    [w, tr, nm] = zone_style(slot)
    color base = zone_color(slot, is_supply)
    array<box> shown_boxes = array.new<box>()
    int n = zones.size()
    if n > 0
        array<float> dist = array.new<float>(n, na)
        for i = 0 to n - 1
            box b = zones.get(i).b
            float d = is_supply ? (b.get_bottom() > close ? b.get_bottom() - close : (b.get_top() >= close ? 0.0 : na)) : (b.get_top() < close ? close - b.get_top() : (b.get_bottom() <= close ? 0.0 : na))
            if use_filter and not anchors.overlaps_any(b.get_top(), b.get_bottom())
                d := na
            dist.set(i, d)
            b.set_bgcolor(color.new(base, 100))
            b.set_border_color(color.new(base, 100))
            b.set_text("")
        int shown = 0
        while shown < show_n
            int best = -1
            float bd = na
            for i = 0 to n - 1
                float d = dist.get(i)
                if not na(d) and (na(bd) or d < bd)
                    bd := d
                    best := i
            if best < 0
                break
            Zone z = zones.get(best)
            box b = z.b
            [bk, tag] = backing(slot, is_supply, b)
            bool is_target = shown == 0 and do_highlight
            b.set_bgcolor(color.new(base, is_target ? target_tr : tr))
            b.set_border_style(line.style_solid)
            string side_nm = nm + (is_supply ? " SUPPLY" : " DEMAND")
            string info = side_nm + " " + str.tostring(b.get_bottom(), format.mintick) + " - " + str.tostring(b.get_top(), format.mintick) + " | base " + str.tostring(z.base_n) + " | " + str.format_time(z.lt, "yyyy-MM-dd") + (z.gap ? " | gap refined" : "") + (z.via_lower ? " | base read below" + (na(z.chk) ? "" : (is_supply ? " | highest close since base " : " | lowest close since base ") + str.tostring(z.chk, format.mintick)) : "")
            b.set_text(show_zone_info ? info : (is_target or label_targets_only ? "" : side_nm))
            if is_target
                b.set_border_color(highlight_color)
                b.set_border_width(3)
                tgt_zones.push(z)
                tgt_is_sup.push(is_supply)
                tgt_tags.push(tag)
                tgt_slots.push(slot)
            else
                b.set_border_color(base)
                b.set_border_width(w)
            dist.set(best, na)
            shown_boxes.push(b)
            shown += 1
    shown_boxes

// The nearest zone of one side: the closest box above price for supply, below price for demand (a box that
// contains price counts as distance zero). Used for the automatic range and for the Weekly fallback on a Monthly chart.
nearest_zone_box(array<Zone> zones, bool is_supply) =>
    box best = na
    float bd = na
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            box b = zones.get(i).b
            float d = is_supply ? (b.get_bottom() > close ? b.get_bottom() - close : (b.get_top() >= close ? 0.0 : na)) : (b.get_top() < close ? close - b.get_top() : (b.get_bottom() <= close ? 0.0 : na))
            if not na(d) and (na(bd) or d < bd)
                bd := d
                best := b
    best

//-----------------------------------------------------------------------------
// MAIN LOGIC
//-----------------------------------------------------------------------------
process_slot(0, mode_d, show_d, sup_d, dem_d, d_sf, d_st, d_sb, d_stm, d_sn, d_si, d_df, d_dt, d_db, d_dtm, d_dn, d_di, d_c, d_h, d_l, d_a, d_sf_a, d_st_a, d_sb_a, d_stm_a, d_sn_a, d_si_a, d_df_a, d_dt_a, d_db_a, d_dtm_a, d_dn_a, d_di_a, d_c_a, d_h_a, d_l_a, d_a_a, d_stn, d_st0, d_st1, d_stx, d_dtn, d_dt0, d_dt1, d_dtx, d_sg, d_dg, d_sg_a, d_dg_a, d_so, d_do, d_so_a, d_do_a)
process_slot(1, mode_w, show_w, sup_w, dem_w, w_sf, w_st, w_sb, w_stm, w_sn, w_si, w_df, w_dt, w_db, w_dtm, w_dn, w_di, w_c, w_h, w_l, w_a, w_sf_a, w_st_a, w_sb_a, w_stm_a, w_sn_a, w_si_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_dn_a, w_di_a, w_c_a, w_h_a, w_l_a, w_a_a, w_stn, w_st0, w_st1, w_stx, w_dtn, w_dt0, w_dt1, w_dtx, w_sg, w_dg, w_sg_a, w_dg_a, w_so, w_do, w_so_a, w_do_a)
// Monthly is never lower than a Daily or Weekly chart, so it reuses the Weekly lower-tf arrays, which are ignored unless mode is 2
process_slot(2, mode_m, show_m, sup_m, dem_m, m_sf, m_st, m_sb, m_stm, m_sn, m_si, m_df, m_dt, m_db, m_dtm, m_dn, m_di, m_c, m_h, m_l, m_a, w_sf_a, w_st_a, w_sb_a, w_stm_a, w_sn_a, w_si_a, w_df_a, w_dt_a, w_db_a, w_dtm_a, w_dn_a, w_di_a, w_c_a, w_h_a, w_l_a, w_a_a, m_stn, m_st0, m_st1, m_stx, m_dtn, m_dt0, m_dt1, m_dtx, m_sg, m_dg, w_sg_a, w_dg_a, m_so, m_do, w_so_a, w_do_a)

if barstate.islast
    // size the boxes once, on the last bar, so no box is ever positioned off the start of the chart
    int future_time = time + (5 * timeframe.in_seconds() * 1000)
    sup_d.size_all(0, future_time)
    dem_d.size_all(0, future_time)
    sup_w.size_all(1, future_time)
    dem_w.size_all(1, future_time)
    sup_m.size_all(2, future_time)
    dem_m.size_all(2, future_time)
    while tgt_labels.size() > 0
        tgt_labels.pop().delete()
    tgt_zones.clear()
    tgt_is_sup.clear()
    tgt_tags.clear()
    tgt_slots.clear()
    // TARGET always marks the nearest Daily zones, on every chart. The Daily zones are where the entry
    // is taken and where trend is scored, so the Weekly and Monthly charts outline the same Daily boxes
    // the Daily chart does. Only when Daily is switched off does the chart timeframe take over.
    bool hl_d = highlight_nearest and show_d
    bool hl_w = highlight_nearest and not show_d and show_w and mode_w == 0
    bool hl_m = highlight_nearest and not show_d and show_m and mode_m == 0
    int anchor_slot = show_d ? 0 : mode_w == 0 ? 1 : mode_m == 0 ? 2 : 0
    array<box> a_s = array.new<box>()
    array<box> a_d = array.new<box>()
    if anchor_slot == 0
        a_s := refresh(sup_d, true, 0, hl_d, a_s, false)
        a_d := refresh(dem_d, false, 0, hl_d, a_d, false)
    else if anchor_slot == 1
        a_s := refresh(sup_w, true, 1, hl_w, a_s, false)
        a_d := refresh(dem_w, false, 1, hl_w, a_d, false)
    else
        a_s := refresh(sup_m, true, 2, hl_m, a_s, false)
        a_d := refresh(dem_m, false, 2, hl_m, a_d, false)
    // Daily is always drawn (it is the anchor unless switched off). Weekly below a Monthly chart is never
    // drawn. Every other non-anchor timeframe follows the correlation rule.
    if anchor_slot != 0
        refresh(sup_d, true, 0, hl_d, a_s, corr_only)
        refresh(dem_d, false, 0, hl_d, a_d, corr_only)
    if anchor_slot != 1
        if mode_w == 2
            // Weekly below a Monthly chart stays hidden, except on a side where the Monthly has no zone at all:
            // there the nearest Weekly zones stand in, the same ones the automatic range borrows
            if na(nearest_zone_box(sup_m, true))
                refresh(sup_w, true, 1, false, a_s, corr_only)
            else
                sup_w.hide_all(true, 1)
            if na(nearest_zone_box(dem_m, false))
                refresh(dem_w, false, 1, false, a_d, corr_only)
            else
                dem_w.hide_all(false, 1)
        else
            refresh(sup_w, true, 1, hl_w, a_s, corr_only)
            refresh(dem_w, false, 1, hl_w, a_d, corr_only)
    if anchor_slot != 2
        refresh(sup_m, true, 2, false, a_s, corr_only)
        refresh(dem_m, false, 2, false, a_d, corr_only)

//-----------------------------------------------------------------------------
// TREND STATE
// The same alternating swings the zig zag draws, scored with the 3 segment rule on closes.
// Returns [state, control point, last high, previous high, last low, previous low]; state 1 up, -1 down, 0 range.
//-----------------------------------------------------------------------------
trend_pack() =>
    // Break of structure, the way the sheet scores it. A candle that closes below the last confirmed swing low
    // starts a downtrend and the swing high before that break is the control point; each later lower high
    // becomes the new control point; a close above the control point ends the downtrend and, being a close
    // above the last swing high, starts the uptrend. Mirror for up. The sequence of swings matters: a higher
    // high followed by a close through the higher low is the first leg down, not a range.
    var bool up = false
    var float sh1 = na
    var float sh2 = na
    var float sl1 = na
    var float sl2 = na
    var float last = na
    var int state = 0
    var float cp = na
    float ph = ta.pivothigh(high, zz_len, zz_right)
    float pl = ta.pivotlow(low, zz_len, zz_right)
    bool is_high = not na(ph)
    bool is_low = not na(pl)
    if na(last)
        last := close
    // alternating swing tracker: one high, then one low, then one high ...
    if up and is_high
        if ph > last
            last := ph
            sh1 := ph
    else if up and is_low
        up := false
        last := pl
        sl2 := sl1
        sl1 := pl
    else if not up and is_low
        if pl < last
            last := pl
            sl1 := pl
    else if not up and is_high
        up := true
        last := ph
        sh2 := sh1
        sh1 := ph
    // a confirmed swing that extends the pullback side moves the control point: lower high in a downtrend, higher low in an uptrend
    // (a trend that began before its first pullback swing existed takes the first confirmed swing as its control point)
    if state == -1 and is_high and (na(cp) or ph < cp)
        cp := ph
    if state == 1 and is_low and (na(cp) or pl > cp)
        cp := pl
    // breaks are judged on the close. Resistance to beat: the control point in a downtrend, else the last swing high. Mirror for support.
    float res = state == -1 and not na(cp) ? cp : sh1
    float sup = state == 1 and not na(cp) ? cp : sl1
    if state != 1 and not na(res) and close > res
        state := 1
        cp := sl1
    else if state != -1 and not na(sup) and close < sup
        state := -1
        cp := sh1
    [state, cp, sh1, sh2, sl1, sl2]

trend_line(string nm, int st, float cp, float sh1, float sh2, float sl1, float sl2) =>
    string st_s = st == 1 ? "UP" : st == -1 ? "DOWN" : "RANGE (no break of structure yet)"
    string cp_s = st == 1 ? " | control point " + str.tostring(cp, format.mintick) + " (a close below ends it)" : st == -1 ? " | control point " + str.tostring(cp, format.mintick) + " (a close above ends it)" : ""
    string piv = (na(sh2) or na(sl2)) ? "" : " | highs " + str.tostring(sh1, format.mintick) + (sh1 > sh2 ? " > " : " < ") + str.tostring(sh2, format.mintick) + " | lows " + str.tostring(sl1, format.mintick) + (sl1 > sl2 ? " > " : " < ") + str.tostring(sl2, format.mintick)
    nm + " TREND: " + st_s + cp_s + piv

[t_st, t_cp, t_sh1, t_sh2, t_sl1, t_sl2] = request.security(syminfo.tickerid, trend_tf, trend_pack())
[c_st, c_cp, c_sh1, c_sh2, c_sl1, c_sl2] = trend_pack()

var table trend_box = table.new(position.top_right, 1, 2, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.white, 60))
if barstate.islast and show_trend
    trend_box.cell(0, 0, trend_line(tf_name(trend_tf), t_st, t_cp, t_sh1, t_sh2, t_sl1, t_sl2), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    if timeframe.in_seconds(trend_tf) != chart_sec
        trend_box.cell(0, 1, trend_line(tf_name(timeframe.period), c_st, c_cp, c_sh1, c_sh2, c_sl1, c_sl2), text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_left)
    else
        trend_box.cell(0, 1, "", text_size=size.small)

//-----------------------------------------------------------------------------
// SETUP SCORE AND ALERTS
// The indicator scores each target zone on the sheet's six checks, 20 points, with an automatic range
// (100% at the middle of the nearest High timeframe supply, 0% at the middle of the nearest High timeframe demand)
// and an automatic risk to reward (entry at the zone's near edge, stop at its far edge, target at the other target zone).
//-----------------------------------------------------------------------------
// The automatic range: 100% at the middle of the nearest High timeframe supply above price, 0% at the middle of the
// nearest High timeframe demand below. When a side has no High timeframe zone (a market at its highs or lows), the
// nearest Mid timeframe zone on that side stands in, even on a chart where Mid zones are not drawn.
range_levels() =>
    box s = nearest_zone_box(sup_m, true)
    box d = nearest_zone_box(dem_m, false)
    string s_nm = tf_name(TF2)
    string d_nm = tf_name(TF2)
    if na(s)
        s := nearest_zone_box(sup_w, true)
        s_nm := tf_name(TF1)
    if na(d)
        d := nearest_zone_box(dem_w, false)
        d_nm := tf_name(TF1)
    float top = na(s) ? na : (s.get_top() + s.get_bottom()) / 2
    float btm = na(d) ? na : (d.get_top() + d.get_bottom()) / 2
    [top, btm, s_nm, d_nm]

// Returns [total, range, time, trend, move, os, purity, rrr, rrr_ratio, move_ratio, range_pos]
score_zone(Zone z, bool is_supply, float r_top, float r_btm, box opp, string opp_nm) =>
    box b = z.b
    float top = b.get_top()
    float btm = b.get_bottom()
    float mid = (top + btm) / 2
    float hgt = top - btm
    int s_range = 0
    float pos = na
    if not na(r_top) and not na(r_btm) and r_top > r_btm
        pos := (mid - r_btm) / (r_top - r_btm)
        s_range := is_supply ? (pos >= 0.75 ? 2 : pos > 0.25 ? 1 : 0) : (pos <= 0.25 ? 2 : pos < 0.75 ? 1 : 0)
    int s_time = z.base_n <= 3 ? 2 : z.base_n <= 6 ? 1 : 0
    // trend on arrival: the Mid readout state, unless price must close through the control point to reach the zone
    int s_trend = 2
    if is_supply
        s_trend := t_st == -1 ? ((na(t_cp) or btm < t_cp) ? 4 : 2) : t_st == 1 ? 0 : 2
    else
        s_trend := t_st == 1 ? ((na(t_cp) or top > t_cp) ? 4 : 2) : t_st == -1 ? 0 : 2
    float ratio = na(z.ext) or hgt <= 0 ? na : (is_supply ? btm - z.ext : z.ext - top) / hgt
    int s_move = not na(ratio) and ratio >= 2 ? 2 : 0
    int s_os = z.os ? 2 : 0
    int s_pur = z.touches == 0 ? 4 : (z.touches == 1 and z.depth < 0.5 ? 2 : 0)
    float rrr = na
    if not na(opp) and hgt > 0
        float entry = is_supply ? btm : top
        float target = is_supply ? opp.get_top() : opp.get_bottom()
        float reward = is_supply ? entry - target : target - entry
        if reward > 0
            rrr := reward / hgt
    int s_rrr = na(rrr) ? 0 : rrr >= 5 ? 4 : rrr >= 3 ? 2 : 0
    int total = s_range + s_time + s_trend + s_move + s_os + s_pur + s_rrr
    [total, s_range, s_time, s_trend, s_move, s_os, s_pur, s_rrr, rrr, ratio, pos, opp_nm]

// Entry timing, the sheet's rule: a trade is only taken on the retest of the zone, except when the impulse gapped away
// from the base, which allows an entry before any retest. A go needs the score as well.
entry_state(Zone z, int total) =>
    bool valid = total >= alert_min
    bool go = valid and (z.inside or (z.gap_out and z.touches == 0))
    string st = not valid ? "NO (score under " + str.tostring(alert_min) + ")" : z.inside ? "GO (retest now)" : (z.gap_out and z.touches == 0) ? "GO (gap away, no retest needed)" : "WAIT FOR RETEST"
    [go, st]

score_line(int total, int s_range, int s_time, int s_trend, int s_move, int s_os, int s_pur, int s_rrr, float rrr, float ratio, float pos, string opp_nm, float r_top, float r_btm, string r_top_nm, string r_btm_nm) =>
    "SCORE " + str.tostring(total) + "/20 | range " + (na(pos) ? "? (no HTF zones)" : str.tostring(s_range) + (show_zone_info ? " (" + str.tostring(math.round(pos * 100)) + "% of " + str.tostring(r_btm, format.mintick) + " " + r_btm_nm + " to " + str.tostring(r_top, format.mintick) + " " + r_top_nm + ")" : "")) + " | time " + str.tostring(s_time) + " | trend " + str.tostring(s_trend) + " | move " + str.tostring(s_move) + (na(ratio) ? "" : " (" + str.tostring(ratio, "#.#") + "x)") + " | OS " + str.tostring(s_os) + " | purity " + str.tostring(s_pur) + " | rrr " + str.tostring(s_rrr) + (na(rrr) ? " (no opposing zone)" : " (" + str.tostring(rrr, "#.#") + ":1" + (opp_nm == "" ? "" : " to " + opp_nm) + ")")

num(float x) =>
    na(x) ? "null" : str.tostring(x, "#.####")

setup_json(Zone z, bool is_supply, int slot, string tag, int total, int s_range, int s_time, int s_trend, int s_move, int s_os, int s_pur, int s_rrr, float rrr, float ratio, float pos, string opp_nm, bool go, string status) =>
    box b = z.b
    [w, tr, nm] = zone_style(slot)
    '{"side":"' + (is_supply ? "SELL" : "BUY") + '","zone":"' + nm + (is_supply ? " SUPPLY " : " DEMAND ") + str.tostring(b.get_bottom(), format.mintick) + " - " + str.tostring(b.get_top(), format.mintick) + '","top":' + num(b.get_top()) + ',"btm":' + num(b.get_bottom()) + ',"backing":"' + str.trim(tag) + '","base":' + str.tostring(z.base_n) + ',"touches":' + str.tostring(z.touches) + ',"depth":' + num(z.depth) + ',"os":' + (z.os ? "true" : "false") + ',"gap":' + (z.gap ? "true" : "false") + ',"score":' + str.tostring(total) + ',"checks":{"range":' + str.tostring(s_range) + ',"time":' + str.tostring(s_time) + ',"trend":' + str.tostring(s_trend) + ',"move":' + str.tostring(s_move) + ',"os":' + str.tostring(s_os) + ',"purity":' + str.tostring(s_pur) + ',"rrr":' + str.tostring(s_rrr) + '},"rrr_ratio":' + num(rrr) + ',"rrr_target":"' + opp_nm + '","gap_out":' + (z.gap_out ? "true" : "false") + ',"go":' + (go ? "true" : "false") + ',"entry":"' + status + '"' + ',"move_ratio":' + num(ratio) + ',"range_pos":' + num(pos) + '}'

// approach: how far price has travelled between the two target zones toward the one ahead
var float prog_prev = na
bool approach_now = false
if barstate.islast
    Zone tgt_sup = na
    Zone tgt_dem = na
    string tgt_sup_tag = ""
    string tgt_dem_tag = ""
    int tgt_sup_slot = 0
    int tgt_dem_slot = 0
    if tgt_zones.size() > 0
        for i = 0 to tgt_zones.size() - 1
            if tgt_is_sup.get(i)
                tgt_sup := tgt_zones.get(i)
                tgt_sup_tag := tgt_tags.get(i)
                tgt_sup_slot := tgt_slots.get(i)
            else
                tgt_dem := tgt_zones.get(i)
                tgt_dem_tag := tgt_tags.get(i)
                tgt_dem_slot := tgt_slots.get(i)
    [r_top, r_btm, r_top_nm, r_btm_nm] = range_levels()
    string s_json = ""
    string d_json = ""
    // The profit target for risk to reward is the next opposing zone in the way: the other Low timeframe target when
    // there is one, otherwise the nearest Mid timeframe zone on that side, otherwise the nearest High timeframe zone.
    // The label says which timeframe the target came from when it is not the Low timeframe
    if not na(tgt_sup)
        box opp = na
        string opp_nm = ""
        if not na(tgt_dem)
            opp := tgt_dem.b
        else
            opp := nearest_zone_box(dem_w, false)
            opp_nm := tf_name(TF1) + " demand"
            if na(opp)
                opp := nearest_zone_box(dem_m, false)
                opp_nm := tf_name(TF2) + " demand"
            if na(opp)
                opp_nm := ""
        [tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm] = score_zone(tgt_sup, true, r_top, r_btm, opp, opp_nm)
        [s_go, s_ent] = entry_state(tgt_sup, tot)
        mark_target(tgt_sup_slot, true, tgt_sup, tgt_sup_tag, show_score ? score_line(tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm, r_top, r_btm, r_top_nm, r_btm_nm) : "", s_ent, s_go)
        s_json := setup_json(tgt_sup, true, tgt_sup_slot, tgt_sup_tag, tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm, s_go, s_ent)
    if not na(tgt_dem)
        box opp = na
        string opp_nm = ""
        if not na(tgt_sup)
            opp := tgt_sup.b
        else
            opp := nearest_zone_box(sup_w, true)
            opp_nm := tf_name(TF1) + " supply"
            if na(opp)
                opp := nearest_zone_box(sup_m, true)
                opp_nm := tf_name(TF2) + " supply"
            if na(opp)
                opp_nm := ""
        [tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm] = score_zone(tgt_dem, false, r_top, r_btm, opp, opp_nm)
        [d_go, d_ent] = entry_state(tgt_dem, tot)
        mark_target(tgt_dem_slot, false, tgt_dem, tgt_dem_tag, show_score ? score_line(tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm, r_top, r_btm, r_top_nm, r_btm_nm) : "", d_ent, d_go)
        d_json := setup_json(tgt_dem, false, tgt_dem_slot, tgt_dem_tag, tot, a1, a2, a3, a4, a5, a6, a7, rr, mr, rp, onm, d_go, d_ent)
    if not na(tgt_sup) and not na(tgt_dem)
        float s_edge = tgt_sup.b.get_bottom()
        float d_edge = tgt_dem.b.get_top()
        float span = s_edge - d_edge
        if span > 0
            float prog = math.max((close - d_edge) / span, (s_edge - close) / span)
            if not na(prog_prev) and prog >= approach_pct and prog_prev < approach_pct and prog < 1
                approach_now := true
            prog_prev := prog
    // fires on every bar close, with an empty setups list when there is no target, so the board can tell a silent alert from a chart with nothing to report
    if alerts_on and barstate.isconfirmed
        string trend_s = t_st == 1 ? "UP" : t_st == -1 ? "DOWN" : "RANGE"
        string msg = '{"symbol":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","chart_tf":"' + timeframe.period + '","style":"' + style + '","low_tf":"' + tf_name(TF0) + '","mid_tf":"' + tf_name(TF1) + '","high_tf":"' + tf_name(TF2) + '","price":' + num(close) + ',"bar_time":' + str.tostring(time) + ',"trend":"' + trend_s + '","control_point":' + num(t_cp) + ',"range_top":' + num(r_top) + ',"range_btm":' + num(r_btm) + ',"alert_min":' + str.tostring(alert_min) + ',"setups":[' + s_json + (s_json != "" and d_json != "" ? "," : "") + d_json + ']}'
        alert(msg, alert.freq_once_per_bar_close)

alertcondition(approach_now, "Price near a target zone", "{{ticker}}: price has covered 80% of the way to the next target zone")

//-----------------------------------------------------------------------------
// ZIG ZAG AND SWING LABELS (chart timeframe only)
//-----------------------------------------------------------------------------
float n_ph = ta.pivothigh(high, zz_len, zz_right)
float n_pl = ta.pivotlow(low, zz_len, zz_right)

if show_labels
    if not na(n_ph)
        label.new(bar_index[zz_right], n_ph, "High", style=label.style_label_down, color=color.new(color.white, 100), textcolor=label_color, size=size.tiny)
    if not na(n_pl)
        label.new(bar_index[zz_right], n_pl, "Low", style=label.style_label_up, color=color.new(color.white, 100), textcolor=label_color, size=size.tiny)

var line zz_line = na
var float last_zz_price = 0.0
var bool dir_up = false

if bar_index == 0
    last_zz_price := close

if show_zigzag
    bool is_high = not na(n_ph)
    bool is_low = not na(n_pl)

    if dir_up and is_high
        if n_ph > last_zz_price
            last_zz_price := n_ph
            if not na(zz_line)
                zz_line.set_xy2(bar_index[zz_right], last_zz_price)

    else if dir_up and is_low
        dir_up := false
        last_zz_price := n_pl
        if not na(zz_line)
            zz_line := line.new(zz_line.get_x2(), zz_line.get_y2(), bar_index[zz_right], last_zz_price, color=zigzag_color, width=2)

    else if not dir_up and is_low
        if n_pl < last_zz_price
            last_zz_price := n_pl
            if not na(zz_line)
                zz_line.set_xy2(bar_index[zz_right], last_zz_price)

    else if not dir_up and is_high
        dir_up := true
        last_zz_price := n_ph
        if not na(zz_line)
            zz_line := line.new(zz_line.get_x2(), zz_line.get_y2(), bar_index[zz_right], last_zz_price, color=zigzag_color, width=2)

    if na(zz_line) and (is_high or is_low)
        zz_line := line.new(bar_index, close, bar_index[zz_right], is_high ? n_ph : n_pl, color=zigzag_color, width=2)
